#!/usr/bin/env bash
# control-sapling: TechDemo lifecycle and sapling-ctl drive path.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$SKILL_DIR/../../.." && pwd)"
TECHDEMO="$REPO_ROOT/Examples/TechDemo"
FMOD_ROOT="$REPO_ROOT/third_party/fmod"

RUN_ID="${SAPLING_VERIFY_RUN_ID:-default}"
STATE_DIR="${SAPLING_VERIFY_DIR:-/tmp/sapling-verify-$RUN_ID}"
STATE_FILE="$STATE_DIR/state.env"
STDOUT_FILE="$STATE_DIR/stdout.txt"
PID_FILE="$STATE_DIR/pid"
DRIVE_FILE="$STATE_DIR/drive.txt"

die() { echo "control-sapling: $*" >&2; exit 1; }
blocked() { echo "control-sapling: $*" >&2; exit 2; }

load_state() {
  if [[ -f "$STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$STATE_FILE"
  fi
}

save_state() {
  mkdir -p "$STATE_DIR"
  cat > "$STATE_FILE" <<EOF
SAPLING_VERIFY_RUN_ID='$RUN_ID'
SAPLING_PID='${SAPLING_PID:-}'
SAPLING_BIN='${SAPLING_BIN:-}'
SAPLING_STDOUT='$STDOUT_FILE'
SAPLING_REPO='$REPO_ROOT'
EOF
}

os_family() {
  case "$(uname -s)" in
    Darwin) echo darwin ;;
    MINGW*|MSYS*|CYGWIN*|Windows_NT) echo windows ;;
    Linux) echo linux ;;
    *) echo other ;;
  esac
}

linux_audio_note() {
  cat <<'TXT'
Linux Debug links a header-only FMOD stub (third_party/fmod_stub) plus X11/Xi/Xcursor/OpenGL.
Audio is silent. Framebuffer screenshots work via sapling-ctl on GLCORE.
TXT
}

fmod_ok() {
  local os
  os="$(os_family)"
  case "$os" in
    darwin)
      [[ -f "$FMOD_ROOT/core/lib/libfmod.dylib" && -f "$FMOD_ROOT/studio/lib/libfmodstudio.dylib" ]]
      ;;
    windows)
      [[ -f "$FMOD_ROOT/core/lib/x64/fmod.dll" || -f "$FMOD_ROOT/core/lib/x86/fmod.dll" ]]
      ;;
    linux)
      [[ -f "$REPO_ROOT/third_party/fmod_stub/fmod.hpp" ]]
      ;;
    *)
      return 1
      ;;
  esac
}

find_ctl() {
  for p in \
    "$TECHDEMO/build/Debug/sapling-ctl" \
    "$TECHDEMO/build/Debug/sapling-ctl.exe" \
    "$TECHDEMO/build/Release/sapling-ctl"
  do
    if [[ -x "$p" ]]; then
      echo "$p"
      return
    fi
  done
  return 1
}

require_ctl() {
  local ctl
  ctl="$(find_ctl)" || die "sapling-ctl missing; launch a Debug TechDemo first"
  echo "$ctl"
}

ctl_run() {
  local ctl
  ctl="$(require_ctl)"
  "$ctl" "$@"
}

json_ok() {
  python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("ok") else 1)'
}

json_scene() {
  python3 -c 'import json,sys; d=json.load(sys.stdin); p=d.get("payload", d); print(p.get("scene",""))'
}

png_hash() {
  sha256sum "$1" | awk '{print $1}'
}

find_binary() {
  local build="${1:-Debug}"
  if [[ "$(os_family)" == darwin && "$build" == Release && -f "$TECHDEMO/build/Release/TechDemo.app/Contents/MacOS/TechDemo" ]]; then
    echo "$TECHDEMO/build/Release/TechDemo.app/Contents/MacOS/TechDemo"
    return
  fi
  for p in \
    "$TECHDEMO/build/$build/TechDemo" \
    "$TECHDEMO/build/$build/TechDemo.exe" \
    "$TECHDEMO/build/$build/Debug/TechDemo" \
    "$TECHDEMO/build/$build/Release/TechDemo"
  do
    if [[ -f "$p" ]]; then
      echo "$p"
      return
    fi
  done
  return 1
}

cmd_launch() {
  local build_only=0
  local build_type=Debug
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --build-only) build_only=1 ;;
      --release) build_type=Release ;;
      *) die "unknown launch flag: $1" ;;
    esac
    shift
  done

  mkdir -p "$STATE_DIR"
  : > "$STDOUT_FILE"

  echo "repo=$REPO_ROOT"
  echo "techdemo=$TECHDEMO"
  echo "os=$(uname -s) arch=$(uname -m)"
  echo "run_id=$RUN_ID"
  echo "display=${DISPLAY:-unset}"

  [[ -d "$TECHDEMO" ]] || die "TechDemo directory missing: $TECHDEMO"
  [[ -f "$TECHDEMO/CMakeLists.txt" ]] || die "TechDemo CMakeLists.txt missing"
  [[ -f "$TECHDEMO/Assets/manifest.json" ]] || die "manifest.json missing"

  if [[ ! -f "$TECHDEMO/Assets/Sprites/player.png" || ! -f "$TECHDEMO/Assets/Audio/bgm.wav" ]]; then
    (cd "$TECHDEMO" && python3 generate_assets.py) || die "asset generation failed"
  fi
  if [[ ! -f "$TECHDEMO/Assets/Fonts/game_font.ttf" ]]; then
    die "Assets/Fonts/game_font.ttf missing"
  fi

  if ! fmod_ok; then
    blocked "FMOD platform libraries missing under $FMOD_ROOT"
  fi

  command -v cmake >/dev/null || die "cmake not on PATH"
  echo "==> cmake configure $build_type"
  cmake -B "$TECHDEMO/build/$build_type" -DCMAKE_BUILD_TYPE="$build_type" -S "$TECHDEMO"
  echo "==> cmake build"
  cmake --build "$TECHDEMO/build/$build_type" --parallel "$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)"

  local bin
  bin="$(find_binary "$build_type")" || die "TechDemo binary not found after build"
  SAPLING_BIN="$bin"
  echo "binary=$bin"

  if [[ "$build_only" -eq 1 ]]; then
    save_state
    echo "build-only complete"
    return 0
  fi

  if [[ -f "$PID_FILE" ]]; then
    local old
    old="$(cat "$PID_FILE" || true)"
    if [[ -n "${old:-}" ]] && kill -0 "$old" 2>/dev/null; then
      die "already running PID $old for run $RUN_ID; cleanup first"
    fi
  fi

  echo "==> starting $bin"
  (cd "$(dirname "$bin")" && exec "$bin") >>"$STDOUT_FILE" 2>&1 &
  SAPLING_PID=$!
  echo "$SAPLING_PID" > "$PID_FILE"
  save_state

  local i
  for i in $(seq 1 50); do
    if ! kill -0 "$SAPLING_PID" 2>/dev/null; then
      die "TechDemo exited during startup. stdout in $STDOUT_FILE"
    fi
    if grep -q "Engine init completed" "$STDOUT_FILE" 2>/dev/null; then
      echo "ready pid=$SAPLING_PID"
      return 0
    fi
    sleep 0.1
  done
  echo "warning: started pid=$SAPLING_PID but did not see Engine init completed within 5s"
  return 0
}

cmd_doctor() {
  local os rc=0
  os="$(os_family)"
  echo "control-sapling doctor"
  echo "repo=$REPO_ROOT"
  echo "os=$(uname -s) arch=$(uname -m) family=$os"
  echo "run_id=$RUN_ID"
  echo "state_dir=$STATE_DIR"
  echo "display=${DISPLAY:-unset}"

  if [[ ! -f "$REPO_ROOT/CMakeLists.txt" ]] || [[ ! -f "$TECHDEMO/Assets/manifest.json" ]]; then
    echo "FAIL: not a Sapling checkout with TechDemo manifest"
    rc=1
  else
    echo "OK: Sapling + TechDemo manifest"
  fi

  for f in \
    "$TECHDEMO/Assets/manifest.json" \
    "$TECHDEMO/Assets/Sprites/player.png" \
    "$TECHDEMO/Assets/Audio/bgm.wav" \
    "$TECHDEMO/Assets/Fonts/game_font.ttf"
  do
    if [[ -f "$f" ]]; then
      echo "OK: asset $(basename "$f")"
    else
      echo "FAIL: missing $f"
      rc=1
    fi
  done

  if [[ "$os" == linux ]]; then
    echo "NOTE: Linux Debug uses fmod_stub (no real FMOD .so)"
    linux_audio_note
  fi

  if fmod_ok; then
    echo "OK: FMOD libraries or stub for $os"
  else
    echo "FAIL: FMOD libraries missing for $os under $FMOD_ROOT"
    rc=1
  fi

  load_state
  local bin
  if bin="$(find_binary Debug)" || bin="$(find_binary Release)"; then
    echo "OK: binary $bin"
  else
    echo "FAIL: TechDemo binary not built"
    rc=1
  fi

  if [[ -n "${SAPLING_PID:-}" ]] && kill -0 "$SAPLING_PID" 2>/dev/null; then
    echo "OK: pid $SAPLING_PID alive"
    if [[ -f "$STDOUT_FILE" ]] && grep -q "Engine init completed" "$STDOUT_FILE"; then
      echo "OK: log contains Engine init completed"
    else
      echo "FAIL: log missing Engine init completed"
      rc=1
    fi
    if [[ -f "$STDOUT_FILE" ]] && grep -q "AgentCli listening" "$STDOUT_FILE"; then
      echo "OK: log contains AgentCli listening"
    else
      echo "FAIL: log missing AgentCli listening"
      rc=1
    fi
    local ctl
    if ctl="$(find_ctl)"; then
      if "$ctl" ping | json_ok; then
        echo "OK: sapling-ctl ping"
      else
        echo "FAIL: sapling-ctl ping"
        rc=1
      fi
    else
      echo "FAIL: sapling-ctl not built"
      rc=1
    fi
  else
    echo "FAIL: no running instance for this run id"
    rc=1
  fi

  return "$rc"
}

cmd_key() {
  load_state
  mkdir -p "$STATE_DIR"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) KEY $*" >> "$DRIVE_FILE"
  local hold=0 ms=0 key=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --hold) hold=1; key="$2"; shift 2 ;;
      --ms) ms="$2"; shift 2 ;;
      *) key="$1"; shift ;;
    esac
  done
  [[ -n "$key" ]] || die "usage: control-sapling key <space|w|...> or key --hold w --ms 400"
  local name
  name="$(echo "$key" | tr '[:lower:]' '[:upper:]')"
  case "$name" in
    SPACE|ENTER)
      ctl_run action confirm press
      ;;
    ESCAPE|ESC)
      ctl_run action quit press
      ;;
    *)
      if [[ "$hold" == 1 ]]; then
        ctl_run key "$name" down
        sleep "$(awk "BEGIN { print ($ms == 0 ? 400 : $ms)/1000 }")"
        ctl_run key "$name" up
      else
        ctl_run key "$name" press
      fi
      ;;
  esac
}

cmd_screenshot() {
  local path=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --path) path="$2"; shift 2 ;;
      *) die "usage: control-sapling screenshot --path <png>" ;;
    esac
  done
  [[ -n "$path" ]] || die "screenshot requires --path"
  mkdir -p "$(dirname "$path")"
  load_state
  mkdir -p "$STATE_DIR"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) SCREENSHOT $path" >> "$DRIVE_FILE"
  ctl_run screenshot "$path"
}

cmd_log_grep() {
  local pat=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pattern) pat="$2"; shift 2 ;;
      *) pat="$1"; shift ;;
    esac
  done
  load_state
  [[ -f "$STDOUT_FILE" ]] || die "no stdout file $STDOUT_FILE"
  grep -E -- "$pat" "$STDOUT_FILE" || {
    echo "no match for /$pat/ in $STDOUT_FILE" >&2
    exit 1
  }
}

cmd_cleanup() {
  load_state
  if [[ -n "${SAPLING_PID:-}" ]] && kill -0 "$SAPLING_PID" 2>/dev/null; then
    echo "stopping pid $SAPLING_PID"
    kill "$SAPLING_PID" 2>/dev/null || true
    sleep 0.3
    if kill -0 "$SAPLING_PID" 2>/dev/null; then
      kill -9 "$SAPLING_PID" 2>/dev/null || true
    fi
  else
    echo "no live PID recorded"
  fi
  rm -rf "$STATE_DIR"
  echo "scratch removed: $STATE_DIR"
  echo "evidence kept under $SKILL_DIR/evidence"
}

cmd_ctl() {
  [[ $# -gt 0 ]] || die "usage: control-sapling ctl <sapling-ctl args>"
  ctl_run "$@"
}

reject_unchanged() {
  local before_hash="$1" after_hash="$2" after_scene="$3"
  if [[ "$before_hash" == "$after_hash" ]]; then
    echo "reject: PNG hashes identical ($before_hash)" >&2
    return 1
  fi
  if [[ "$after_scene" == "title" ]]; then
    echo "reject: state.scene is still title" >&2
    return 1
  fi
  return 0
}

cmd_prove() {
  RUN_ID="agent-loop"
  STATE_DIR="${SAPLING_VERIFY_DIR:-/tmp/sapling-verify-$RUN_ID}"
  STATE_FILE="$STATE_DIR/state.env"
  STDOUT_FILE="$STATE_DIR/stdout.txt"
  PID_FILE="$STATE_DIR/pid"
  DRIVE_FILE="$STATE_DIR/drive.txt"

  local evidence="$SKILL_DIR/evidence/agent-loop"
  mkdir -p "$evidence"

  local started=0
  finish() {
    if [[ -f "$STDOUT_FILE" ]]; then
      cp "$STDOUT_FILE" "$SKILL_DIR/evidence/agent-loop/stdout.txt" 2>/dev/null || true
    fi
    cmd_cleanup
  }
  trap finish EXIT

  load_state
  if [[ -n "${SAPLING_PID:-}" ]] && kill -0 "$SAPLING_PID" 2>/dev/null; then
    echo "prove: reuse pid $SAPLING_PID run $RUN_ID"
  else
    cmd_launch
    started=1
  fi
  echo "prove: started_by_prove=$started display=${DISPLAY:-unset}"

  for i in $(seq 1 30); do
    if [[ -f "$STDOUT_FILE" ]] && grep -q "AgentCli listening" "$STDOUT_FILE"; then
      break
    fi
    sleep 0.1
  done

  cmd_doctor || die "doctor failed"

  local ping_ok=0
  local i
  for i in $(seq 1 30); do
    if ctl_run ping | tee "$evidence/ping.json" | json_ok; then
      ping_ok=1
      break
    fi
    sleep 0.1
  done
  [[ "$ping_ok" -eq 1 ]] || die "sapling-ctl ping failed"

  ctl_run state | tee "$evidence/state-before.json" | json_ok || die "state before failed"
  ctl_run screenshot "$evidence/before.png" | tee "$evidence/screenshot-before.json" | json_ok || die "screenshot before failed"
  [[ -s "$evidence/before.png" ]] || die "before.png missing or empty"

  ctl_run action confirm press | tee "$evidence/action-confirm.json" | json_ok || die "action confirm press failed"
  sleep 0.4

  ctl_run state | tee "$evidence/state-after.json" | json_ok || die "state after failed"
  ctl_run screenshot "$evidence/after.png" | tee "$evidence/screenshot-after.json" | json_ok || die "screenshot after failed"
  [[ -s "$evidence/after.png" ]] || die "after.png missing or empty"

  local before_scene after_scene before_hash after_hash
  before_scene="$(json_scene < "$evidence/state-before.json")"
  after_scene="$(json_scene < "$evidence/state-after.json")"
  before_hash="$(png_hash "$evidence/before.png")"
  after_hash="$(png_hash "$evidence/after.png")"

  {
    echo "before_scene=$before_scene"
    echo "after_scene=$after_scene"
    echo "before_sha256=$before_hash"
    echo "after_sha256=$after_hash"
  } | tee "$evidence/hashes.txt"

  set +e
  reject_unchanged "$before_hash" "$before_hash" "$after_scene"
  local dry_rc=$?
  set -e
  if [[ "$dry_rc" -eq 0 ]]; then
    die "fail-closed: identical hashes were not rejected"
  fi
  {
    echo "dry: reject_unchanged same-hash exit=$dry_rc"
    echo "live hashes: $before_hash vs $after_hash"
    echo "scene: $before_scene -> $after_scene"
  } | tee "$evidence/fail-closed.txt"

  reject_unchanged "$before_hash" "$after_hash" "$after_scene" || die "PNG hashes identical or state.scene is still title"

  {
    echo "feature: agent-loop"
    echo "host: $(uname -s)"
    echo "display: ${DISPLAY:-unset}"
    echo "git_rev: $(git -C "$REPO_ROOT" rev-parse HEAD)"
    echo "techdemo_pid: ${SAPLING_PID:-}"
    echo "run_id: $RUN_ID"
    echo "ping: ok"
    echo "action: confirm press (Input, not Engine::changeScene)"
    echo "scene: $before_scene -> $after_scene"
    echo "before_sha256: $before_hash"
    echo "after_sha256: $after_hash"
  } | tee "$evidence/meta.txt"

  echo "prove: ok scene $before_scene -> $after_scene"
}

usage() {
  cat <<EOF
usage: control-sapling <launch|doctor|ctl|prove|key|screenshot|log-grep|cleanup> [args]
  launch [--build-only] [--release]
  doctor
  ctl <sapling-ctl args>
  prove
  key [--hold] <name> [--ms N]
  screenshot --path <png>
  log-grep --pattern <re>
  cleanup
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@"; exit $? ;;
    ctl) cmd_ctl "$@" ;;
    prove) cmd_prove "$@" ;;
    key) cmd_key "$@" ;;
    screenshot) cmd_screenshot "$@" ;;
    log-grep) cmd_log_grep "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    -h|--help|"") usage; exit 1 ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
