      { "name": "floor", "path": "Sprites/floor.png", "mode": "atlas", "frames": 1 },
      { "name": "heart", "path": "Sprites/heart.png", "mode": "atlas", "frames": 1 },
      { "name": "particle", "path": "Sprites/particle.png", "mode": "atlas", "frames": 1 },
      { "name": "debugCircle", "path": "Sprites/debug.png", "mode": "atlas", "frames": 1 }
